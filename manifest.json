{
  "manifest_version": 3,
  "name": "CRM-WEHAVE",
  "version": "1.3.0",
  "description": "Dashboard de Disparo WhatsApp com Gestão e Controle de Fila",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://web.whatsapp.com/*",
    "https://firestore.googleapis.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_title": "Abrir CRM-WEHAVE"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://web.whatsapp.com/*"],
      "js": ["content.js"]
    }
  ]
}
